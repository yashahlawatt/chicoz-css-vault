# CHICOZ CSS VAULT — environment template
# Copy to .env (or set in your host's dashboard: Vercel/Netlify/Docker).

# Canonical site URL — drives <link rel="canonical">, OpenGraph URL and the
# sitemap identity. Set this to whatever domain you deploy on.
NEXT_PUBLIC_SITE_URL=https://chicozcssvault.eu.org

# SQLite database file for Prisma (favorites storage).
# Use an absolute path in production, e.g. inside Docker: file:/app/db/custom.db
DATABASE_URL=file:/app/db/custom.db
